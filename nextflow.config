process {
    executor = 'slurm'
    queue = 'defq'

    withName: NET_METRICS {
        cpus = 1
        memory = '16 GB'               // ajusta según el tamaño de tus redes
        time = '24h'
    }
    withName: BETA_PAIR {
        cpus = 1
        memory = '4 GB'
        time = '1h'
    }
}

executor {
    queueSize = 20
    submitRateLimit = '10/1min'
}